    "# Same lead-lag setup as the savings chart above, on month-over-month changes so shared trend doesn't inflate it\n",
    "lags = range(-6, 7)\n",
    "index_chg = trends_df['distress_search_index'].diff().reset_index(drop=True)\n",
    "complaint_chg = np.log(trends_df['cfpb_bnpl_complaints']).diff().reset_index(drop=True)\n",
    "\n",
    "cross_corrs = []\n",
    "for lag in lags:\n",
    "    if lag < 0:\n",
    "        # Search index leads complaints by |lag| months\n",
    "        c = index_chg.iloc[:lag].corr(complaint_chg.iloc[-lag:].reset_index(drop=True))\n",
    "    elif lag > 0:\n",
    "        # Complaints lead the search index by lag months\n",
    "        c = index_chg.iloc[lag:].reset_index(drop=True).corr(complaint_chg.iloc[:-lag])\n",
    "    else:\n",
    "        c = index_chg.corr(complaint_chg)\n",
    "    cross_corrs.append(c)\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "plt.bar(lags, cross_corrs, color=['#d62728' if c < 0 else '#1f77b4' for c in cross_corrs], alpha=0.75, edgecolor='white', width=0.6)\n",
    "plt.axvline(0, color='white', linestyle='--', linewidth=1)\n",
    "plt.axhline(0, color='gray', linestyle='-', linewidth=0.8)\n",
    "plt.xlabel('Lag in Months (Negative = Search Index leads Complaints)', fontsize=11, fontweight='bold')\n",
    "plt.ylabel('Cross-Correlation (MoM changes)', fontsize=11, fontweight='bold')\n",
    "plt.title('Lead-Lag Cross-Correlation: Distress Search Index vs. BNPL Complaint Growth', fontsize=13, fontweight='bold', pad=12)\n",
    "plt.xticks(lags)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "best = int(np.nanargmax(np.abs(cross_corrs)))\n",
    "print(f\"Peak |correlation| {cross_corrs[best]:.3f} at lag {list(lags)[best]} months\")"
   ]
