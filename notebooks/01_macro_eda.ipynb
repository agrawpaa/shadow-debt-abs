    "# Resolve the project root dynamically so the notebook is portable across machines.\n",
    "# Start from the current working directory and walk up until we find the `data/` folder;\n",
    "# if that fails (e.g. launched elsewhere), fall back to walking up from this file.\n",
    "def _find_root(start: Path) -> Path:\n",
    "    node = start.resolve()\n",
    "    while node.parent != node:\n",
    "        if (node / 'data').exists():\n",
    "            return node\n",
    "        node = node.parent\n",
